{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "piechart", "name": "Pie chart", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" },
    { "type": "panel", "id": "logs", "name": "Logs", "version": "" }
  ],
  "description": "Lead system operational overview — lead intake, enrichment, webhooks, auth, schedulers, JVM, and correlated log panels. LSB-130 + LSB-140.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["leadsystem", "operational"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(leadsystem_leads_received_total, client_id)",
        "hide": 0,
        "includeAll": true,
        "label": "Client",
        "multi": true,
        "name": "client_id",
        "options": [],
        "query": {
          "query": "label_values(leadsystem_leads_received_total, client_id)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "prod", "value": "prod" },
        "hide": 0,
        "includeAll": false,
        "label": "Env",
        "multi": false,
        "name": "env",
        "options": [
          { "selected": true, "text": "prod", "value": "prod" },
          { "selected": false, "text": "dev", "value": "dev" }
        ],
        "query": "prod,dev",
        "type": "custom"
      },
      {
        "current": { "selected": true, "text": "All", "value": ".*" },
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "Marker",
        "multi": true,
        "name": "marker",
        "options": [
          { "selected": false, "text": "LEAD", "value": "LEAD" },
          { "selected": false, "text": "MEETING", "value": "MEETING" },
          { "selected": false, "text": "WEBHOOK", "value": "WEBHOOK" },
          { "selected": false, "text": "SCRAPE", "value": "SCRAPE" },
          { "selected": false, "text": "SCHED", "value": "SCHED" },
          { "selected": false, "text": "AUTH", "value": "AUTH" },
          { "selected": false, "text": "OAUTH", "value": "OAUTH" }
        ],
        "query": "LEAD,MEETING,WEBHOOK,SCRAPE,SCHED,AUTH,OAUTH",
        "type": "custom"
      },
      {
        "current": { "selected": false, "text": "", "value": "" },
        "hide": 0,
        "label": "Request ID",
        "name": "req_id",
        "options": [],
        "query": "",
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Lead System — Operational Overview",
  "uid": "leadsystem-ops-v1",
  "version": 1,
  "panels": [

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1, "title": "Lead Processing", "type": "row" },

    {
      "id": 2, "title": "Leads today",
      "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(increase(leadsystem_leads_received_total{client_id=~\"$client_id\"}[24h]))",
        "legendFormat": "leads", "refId": "A" }]
    },

    {
      "id": 3, "title": "Duplicates today",
      "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 }] } }, "overrides": [] },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(increase(leadsystem_leads_duplicate_total{client_id=~\"$client_id\"}[24h]))",
        "legendFormat": "duplicates", "refId": "A" }]
    },

    {
      "id": 4, "title": "Enrichment hit rate",
      "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.3 }, { "color": "green", "value": 0.6 }] } }, "overrides": [] },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(rate(leadsystem_enrichment_hit_total{outcome=\"hit\"}[1h])) / sum(rate(leadsystem_enrichment_hit_total[1h]))",
        "legendFormat": "hit rate", "refId": "A" }]
    },

    {
      "id": 5, "title": "Auth failures (1h)",
      "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 }] } }, "overrides": [] },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(increase(leadsystem_auth_failure_total[1h]))",
        "legendFormat": "failures", "refId": "A" }]
    },

    {
      "id": 6, "title": "Webhook success rate (1h)",
      "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.9 }, { "color": "green", "value": 0.98 }] } }, "overrides": [] },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(rate(leadsystem_outbound_webhook_total{status=\"success\",client_id=~\"$client_id\"}[1h])) / sum(rate(leadsystem_outbound_webhook_total{status=~\"success|failure\",client_id=~\"$client_id\"}[1h]))",
        "legendFormat": "success rate", "refId": "A" }]
    },

    {
      "id": 7, "title": "HTTP 5xx rate",
      "type": "stat", "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.1 }] } }, "overrides": [] },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))",
        "legendFormat": "5xx/s", "refId": "A" }]
    },

    {
      "id": 10, "title": "Lead intake rate by client",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "rate(leadsystem_leads_received_total{client_id=~\"$client_id\"}[5m])",
        "legendFormat": "client {{client_id}}", "refId": "A" }]
    },

    {
      "id": 11, "title": "Duplicate rejections by client",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 }, "color": { "fixedColor": "orange", "mode": "fixed" } }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "rate(leadsystem_leads_duplicate_total{client_id=~\"$client_id\"}[5m])",
        "legendFormat": "client {{client_id}}", "refId": "A" }]
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 20, "title": "Enrichment, Routing & Webhooks", "type": "row" },

    {
      "id": 21, "title": "Enrichment outcomes",
      "type": "piechart", "gridPos": { "h": 8, "w": 6, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "pieType": "donut", "tooltip": { "mode": "single" }, "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum by (outcome)(increase(leadsystem_enrichment_hit_total[24h]))",
        "legendFormat": "{{outcome}}", "refId": "A" }]
    },

    {
      "id": 22, "title": "Routing matches by rule (1h)",
      "type": "bargauge", "gridPos": { "h": 8, "w": 6, "x": 6, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["sum"] }, "displayMode": "gradient" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } }, "overrides": [] },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum by (rule_id)(increase(leadsystem_routing_matched_total{client_id=~\"$client_id\"}[1h]))",
        "legendFormat": "rule {{rule_id}}", "refId": "A" }]
    },

    {
      "id": 23, "title": "Outbound webhook outcomes",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }, "overrides": [
        { "matcher": { "id": "byLabelValue", "options": { "label": "status", "value": "failure" } }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
        { "matcher": { "id": "byLabelValue", "options": { "label": "status", "value": "success" } }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
      ] },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum by (status)(rate(leadsystem_outbound_webhook_total{client_id=~\"$client_id\"}[5m]))",
        "legendFormat": "{{status}}", "refId": "A" }]
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 30, "title": "Auth, Schedulers & Calendly", "type": "row" },

    {
      "id": 31, "title": "Auth failures by reason (24h)",
      "type": "bargauge", "gridPos": { "h": 6, "w": 8, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["sum"] }, "displayMode": "gradient" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "orange", "mode": "fixed" } }, "overrides": [] },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum by (reason)(increase(leadsystem_auth_failure_total[24h]))",
        "legendFormat": "{{reason}}", "refId": "A" }]
    },

    {
      "id": 32, "title": "Calendly meetings synced per client",
      "type": "timeseries", "gridPos": { "h": 6, "w": 8, "x": 8, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "drawStyle": "bars" } }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "increase(leadsystem_calendly_poll_meetings_synced_total{client_id=~\"$client_id\"}[1h])",
        "legendFormat": "client {{client_id}}", "refId": "A" }]
    },

    {
      "id": 33, "title": "Calendly inbound webhook outcomes",
      "type": "piechart", "gridPos": { "h": 6, "w": 8, "x": 16, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "pieType": "donut", "tooltip": { "mode": "single" }, "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum by (status)(increase(leadsystem_calendly_webhook_total[24h]))",
        "legendFormat": "{{status}}", "refId": "A" }]
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "id": 40, "title": "Infrastructure", "type": "row" },

    {
      "id": 41, "title": "HTTP request duration p95 by endpoint",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "histogram_quantile(0.95, sum by (le, uri)(rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m])))",
        "legendFormat": "{{uri}}", "refId": "A" }]
    },

    {
      "id": 42, "title": "JVM heap usage",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } }, "overrides": [
        { "matcher": { "id": "byName", "options": "used" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
        { "matcher": { "id": "byName", "options": "max" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }, { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }] }
      ] },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "used", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "max", "refId": "B" }
      ]
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 38 },
      "id": 50, "title": "Business Event Stream", "type": "row" },

    {
      "id": 51, "title": "Business events",
      "type": "logs", "gridPos": { "h": 10, "w": 24, "x": 0, "y": 39 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "{app=\"leadsystem\", env=\"$env\", log_type=\"events\", marker=~\"$marker\"}",
        "legendFormat": "", "refId": "A" }]
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 49 },
      "id": 60, "title": "Error Log Explorer", "type": "row" },

    {
      "id": 61, "title": "ERROR / WARN logs (drill-down by requestId)",
      "type": "logs", "gridPos": { "h": 10, "w": 24, "x": 0, "y": 50 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": false },
      "targets": [{ "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "{app=\"leadsystem\", env=\"$env\", log_type=\"full\", level=~\"ERROR|WARN\", clientId=~\"$client_id\"} | json",
        "legendFormat": "", "refId": "A" }]
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 60 },
      "id": 70, "title": "Correlated View — Leads + Logs", "type": "row" },

    {
      "id": 71, "title": "Leads/min",
      "type": "timeseries", "gridPos": { "h": 6, "w": 24, "x": 0, "y": 61 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum by (client_id)(rate(leadsystem_leads_received_total{client_id=~\"$client_id\"}[1m]) * 60)",
        "legendFormat": "client {{client_id}}", "refId": "A" }]
    },

    {
      "id": 72, "title": "All logs (correlated — same time window)",
      "type": "logs", "gridPos": { "h": 10, "w": 24, "x": 0, "y": 67 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "{app=\"leadsystem\", env=\"$env\", log_type=\"full\", clientId=~\"$client_id\"} | json",
        "legendFormat": "", "refId": "A" }]
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 77 },
      "id": 80, "title": "Request Trace", "type": "row" },

    {
      "id": 81, "title": "Trace by requestId — paste req value into $req_id variable",
      "type": "logs", "gridPos": { "h": 10, "w": 24, "x": 0, "y": 78 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Ascending", "wrapLogMessage": true },
      "targets": [{ "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "{app=\"leadsystem\", env=\"$env\", log_type=\"full\"} | json | req=\"$req_id\"",
        "legendFormat": "", "refId": "A" }]
    }

  ]
}
